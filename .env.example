# Public HTTPS DNS name configured in aaPanel/Nginx. This host is also written
# into generated WireGuard client profiles; do not include https:// or a port.
SITE_ADDRESS=inspector.example.com

# Localhost-only HTTP port used by aaPanel/Nginx reverse proxy.
# Default is 28080 so it is easy to spot and less likely to clash.
PANEL_HTTP_PORT=28080

# Public UDP port used by mitmproxy WireGuard mode and client profiles.
WIREGUARD_PORT=51820

# Operator controls. Zero means unlimited/no automatic deletion.
RETENTION_DAYS=0
STORAGE_QUOTA_BYTES=0
PREVIEW_BYTES=262144

# Explicitly allow destinations denied by the SSRF guard. Keep empty unless
# the administrator understands the risk. Comma-separated IP/CIDR/hostnames.
SAFE_DESTINATION_OVERRIDES=
